{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/n8n/[slot].js": {
      "maxDuration": 300
    },
    "api/email/[action].js": {
      "maxDuration": 300
    },
    "api/leads/[action].js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "leads.araklighting.com"
        }
      ],
      "destination": "https://sales.araklighting.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "leads.arak-sa.com"
        }
      ],
      "destination": "https://sales.araklighting.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/email/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/agent/chat?cron=ceo-brief",
      "schedule": "0 4 * * 0"
    }
  ]
}
